# Copy to .env.local for development. Never commit .env.local.

# --- Database (Phase 03) ---------------------------------------------------
# Postgres connection string. Everything degrades gracefully without it:
#   POST /api/leads answers 503 so the client falls back to composing an email
#   POST /api/quiz  answers { ok: true, stored: false } and the page carries on
# There is one connection string — Postgres is local to the VPS, so no
# pooled/unpooled split (§6.1).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/rem_assist

# --- Lead notification (§9.3) ----------------------------------------------
# Webhook that receives a plain-text summary on every lead. A Slack incoming
# webhook works as-is. Unset = notifications are skipped silently.
# LEAD_WEBHOOK_URL=

# --- Site (§11) ------------------------------------------------------------
# Origin used for canonicals, OG urls and the sitemap. Defaults to
# https://remassistance.com — set this on staging so its pages do not declare
# production canonicals.
# NEXT_PUBLIC_SITE_URL=https://staging.remassistance.com
